# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# For Local Development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# For Production / Vercel (PostgreSQL - Neon, Supabase, or Vercel Postgres):
# Note: Use the pooled connection string (e.g. -pooler in Neon) with sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Generate a strong 32+ character random secret in terminal: openssl rand -base64 32
JWT_SECRET="your-super-secure-production-jwt-secret-key-min-32-chars-long"

# ==============================================================================
# DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ==============================================================================
# Create a free Redis database at https://upstash.com/ for persistent serverless rate limiting.
# If not configured, the CRM gracefully falls back to an in-memory sliding-window limiter.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ==============================================================================
# APPLICATION URL
# ==============================================================================
# Set to your live production domain (e.g., https://admissions.xyzcollege.edu)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# DEMO ACCESS (DEFAULT DISABLED IN PRODUCTION)
# ==============================================================================
# Set to "true" only in isolated development sandbox environments to show demo buttons
NEXT_PUBLIC_SHOW_DEMO_LOGINS="false"
